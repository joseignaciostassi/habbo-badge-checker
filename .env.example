DATABASE_URL=postgres://postgres:password@localhost:5432/badge_checker
BADGES_DIR=./badges
# Similarity: hashes are a coarse prefilter (max Hamming distance, 0-64),
# design score (edge map IoU, 0-1) is the verification.
SIM_DHASH_MAX=20
SIM_SILHOUETTE_MAX=10
# Design thresholds calibrated with labeled pairs (/calibrate):
# web check ~93% precision, scan ~99% precision (oriented edges).
SIM_DESIGN_MIN=0.575
SIM_SCAN_DESIGN_MIN=0.725
